---
import { imagen, type Producto } from "../lib/catalogo";
import Icono from "./Icono.astro";
interface Props {
  producto: Producto;
  principal?: boolean;
}
const { producto, principal = false } = Astro.props;
const src = imagen(producto);
---

<div class:list={["product-image", { principal }]}>
  <div class="image-placeholder" aria-hidden={Boolean(src)}>
    <Icono nombre="box" />
    <span>Imagen no disponible</span>
  </div>
  {src && (
    <img
      src={src}
      srcset={`${imagen(producto, 320)} 320w, ${imagen(producto, 640)} 640w, ${imagen(producto, 960)} 960w`}
      sizes={
        principal
          ? "(max-width:760px) 90vw, 50vw"
          : "(max-width:540px) 45vw, (max-width:1100px) 30vw, 22vw"
      }
      alt={producto.nombre}
      width="640"
      height="640"
      loading={principal ? "eager" : "lazy"}
      decoding="async"
      data-product-image
    />
  )}
</div>
