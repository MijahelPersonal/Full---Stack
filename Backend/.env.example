# Copiar a .env.properties dentro de Backend y configurar valores locales.
# También se admiten DB_USERNAME, DB_PASSWORD y JWT_SECRET como variables de entorno.
spring.datasource.username=REEMPLAZAR_USUARIO_LOCAL
spring.datasource.password=REEMPLAZAR_PASSWORD_LOCAL
app.jwt.secret=REEMPLAZAR_CLAVE_JWT_ALEATORIA_DE_AL_MENOS_32_BYTES
