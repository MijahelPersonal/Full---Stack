---
import Layout from '../../layouts/Layout.astro';
import {sesion,tienda,CuentaError,etiqueta,type Pedido} from '../../lib/cuenta';
import {dinero} from '../../lib/catalogo';
Astro.response.headers.set('Cache-Control','no-store');
let pedido:Pedido|null=null,error='';
try{const cuenta=await sesion(Astro.cookies);if(!cuenta)return Astro.redirect('/cuenta?seccion=pedidos');pedido=await tienda<Pedido>(`pedidos/${Astro.params.id}`,Astro.cookies);}catch(e){error=e instanceof CuentaError?e.message:'No se pudo cargar el pedido';Astro.response.status=e instanceof CuentaError?e.status:503;}
---
<Layout title="Constancia de pedido"><div class="container page-shell"><section class="account-panel order-receipt">{pedido?<><p class="eyebrow">CONSTANCIA DE PEDIDO</p><h1>{pedido.estado==='PENDIENTE'?'Pedido registrado':'Tu pedido'}</h1><p>Código de recojo</p><h2 class="pickup-code">{pedido.codigoRecojo}</h2><p>Conserva este código y preséntalo al recoger tu pedido.</p><dl><div><dt>Cliente</dt><dd>{pedido.clienteNombre}</dd></div><div><dt>Fecha</dt><dd>{new Date(pedido.fechaCreacion).toLocaleString('es-PE')}</dd></div><div><dt>Estado</dt><dd>{etiqueta(pedido.estado)}</dd></div><div><dt>Modalidad</dt><dd>RECOJO EN TIENDA</dd></div></dl><div class="orders-table"><table><thead><tr><th>Producto</th><th>Cantidad</th><th>Precio</th><th>Subtotal</th></tr></thead><tbody>{pedido.detalles.map(l=><tr><td>{l.nombreHistorico}</td><td>{l.cantidad}</td><td>{dinero(l.precioUnitario)}</td><td>{dinero(l.subtotal)}</td></tr>)}</tbody></table></div><h2>TOTAL {dinero(pedido.total)}</h2><p>El total es informativo. Esta constancia no acredita un pago.</p><div class="receipt-actions"><button class="button" data-print>Imprimir / guardar como PDF</button><a class="button button-outline" href="/cuenta?seccion=pedidos">Mis pedidos</a><a class="text-link" href={Astro.url.pathname}>Actualizar estado</a></div></>:<><h1>No pudimos mostrar el pedido</h1><p role="alert">{error}</p><a href="/cuenta?seccion=pedidos">Volver a mis pedidos</a></>}</section></div></Layout>
<script>document.querySelector('[data-print]')?.addEventListener('click',()=>window.print());</script>
<style>.order-receipt{max-width:920px;margin:auto}.pickup-code{font-size:clamp(1.2rem,4vw,2rem);overflow-wrap:anywhere;letter-spacing:.025em}.receipt-actions{display:flex;gap:1rem;flex-wrap:wrap}.order-receipt dl>div{display:flex;justify-content:space-between;gap:1rem;padding:.5rem 0}.order-receipt dd{margin:0;text-align:right}.orders-table{overflow:auto;margin:1.5rem 0}table{width:100%;border-collapse:collapse}th,td{padding:.7rem;text-align:left;border-bottom:1px solid #444}@media print{:global(header),:global(footer),:global(.cart-toast),:global(.scroll-progress),.receipt-actions{display:none!important}:global(body){background:white!important;color:black!important}.order-receipt{background:white!important;color:black!important;border:0!important;box-shadow:none!important}:global(.page-shell){padding:0!important}}</style>
