# Referencia de variables de despliegue; no se carga automáticamente.
# Railway / Backend
SPRING_PROFILES_ACTIVE=prod
DATABASE_URL=
PGHOST=
PGPORT=5432
PGDATABASE=
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
FRONTEND_URL=
UPLOAD_DIR=/data/uploads
# PORT lo proporciona Railway.

# Vercel / Astro: origen HTTPS del backend, sin /api.
DEPLOY_TARGET=vercel
API_URL=

# Build de Electron: origen HTTPS del backend terminado en /api.
GESTION_API_URL=

# Herramienta de traslado: credenciales del administrador de cada entorno.
TRANSFER_USERNAME=
TRANSFER_PASSWORD=
