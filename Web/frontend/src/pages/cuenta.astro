---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import {sesion,tienda,etiqueta,CuentaError,type Pedido,type Cuenta} from '../lib/cuenta';
import {dinero} from '../lib/catalogo';
Astro.response.headers.set('Cache-Control','no-store');
let cuenta:Cuenta|null=null,error='',pedidos:Pedido[]=[];
try{cuenta=await sesion(Astro.cookies);if(cuenta)pedidos=await tienda<Pedido[]>('pedidos',Astro.cookies);}catch(e){error=e instanceof CuentaError?e.message:'No se pudo cargar tu cuenta';}
const registro=Astro.url.searchParams.get('modo')==='registro';
const destino=Astro.url.searchParams.get('volver')==='/finalizar-compra'?'/finalizar-compra':'/cuenta?seccion=pedidos';
---
<Layout title="Mi cuenta"><div class="container page-shell"><Breadcrumb titulo="Mi cuenta"/><div class="account-layout"><aside class="account-nav"><h2>MI CUENTA</h2><a href="/cuenta">Mi cuenta</a><a href="/cuenta?seccion=pedidos">Mis pedidos</a><a href="/carrito">Mi carrito</a>{cuenta&&<button class="button button-outline" data-logout>Cerrar sesión</button>}</aside><section class="account-panel">
{error&&<p role="alert">{error}</p>}
{cuenta?<><p class="eyebrow">BIENVENIDO A STRUCH</p><h1>{cuenta.nombre}</h1><p>{cuenta.email} · {cuenta.telefono}</p><h2>Mis pedidos</h2><p>Modalidad: recojo en tienda. Consulta aquí el estado antes de acercarte.</p><div class="orders-table"><table><thead><tr><th>Código</th><th>Fecha</th><th>Total</th><th>Estado</th><th></th></tr></thead><tbody>{pedidos.map(p=><tr><td>{p.codigoRecojo}</td><td>{new Date(p.fechaCreacion).toLocaleDateString('es-PE')}</td><td>{dinero(p.total)}</td><td>{etiqueta(p.estado)}</td><td><a href={`/pedidos/${p.id}`}>Ver pedido →</a></td></tr>)}</tbody></table></div>{!pedidos.length&&<p>Todavía no tienes pedidos. Explora nuestros productos para comenzar.</p>}<a class="button" href="/productos">Explorar productos</a></>:<><p class="eyebrow">BIENVENIDO A STRUCH</p><h1>{registro?'Crea tu cuenta.':'Tu próximo paso empieza aquí.'}</h1><p>Accede a tus pedidos y a tu código de recojo.</p><div class="account-tabs"><a class:list={{active:!registro}} href={`/cuenta?volver=${encodeURIComponent(destino)}`}>Iniciar sesión</a><a class:list={{active:registro}} href={`/cuenta?modo=registro&volver=${encodeURIComponent(destino)}`}>Registrarse</a></div><form class="account-form" data-account-form data-accion={registro?'registro':'login'}><input type="hidden" name="destino" value={destino}/>{registro&&<><label>Nombres<input name="nombres" autocomplete="given-name" required maxlength="80"/></label><label>Apellidos<input name="apellidos" autocomplete="family-name" required maxlength="79"/></label><label>Teléfono<input name="telefono" type="tel" autocomplete="tel" required maxlength="30"/></label><label>Documento (opcional)<input name="documento" maxlength="30"/></label></>}<label>Correo electrónico<input name="email" type="email" autocomplete="email" required maxlength="160"/></label><label>Contraseña<input name="password" type="password" autocomplete={registro?'new-password':'current-password'} required minlength={registro?8:undefined} maxlength="72"/></label><p data-account-error role="alert"></p><button class="button" type="submit">{registro?'Crear cuenta':'Iniciar sesión'}</button></form></>}
</section></div></div></Layout>
<script>import '../scripts/cuenta';</script>
<style>.orders-table{overflow:auto;margin:1.5rem 0}table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:.8rem;border-bottom:1px solid var(--border,#333);white-space:nowrap}</style>
