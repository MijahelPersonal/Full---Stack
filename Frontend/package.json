{
  "name": "frontend",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "electron:dev": "node electron/dev.cjs",
    "electron:smoke:dev": "node electron/dev.cjs --smoke",
    "build:desktop": "ng build --configuration production,desktop",
    "electron:start": "electron .",
    "electron:smoke": "electron . --smoke",
    "desktop:prepare": "node electron/prepare-production.cjs",
    "desktop:verify": "npm run build:desktop && electron-builder --dir",
    "desktop:package": "npm run desktop:prepare && npm run build:desktop && electron-builder --publish never",
    "test:electron": "node --test electron/updater.test.cjs"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "electron-updater": "^6.8.9",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "main": "electron/main.cjs",
  "description": "SistemaGestión: inventario, pedidos y ventas",
  "author": "MijahelPersonal"
}
